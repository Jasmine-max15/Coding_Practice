-- ============================================================
-- SCENARIO 1: Update Profile / Email change validation
-- ============================================================

UPDATE users
SET email = 'john.updated@mail.com'
WHERE user_id = 1;

SELECT user_id, email, updated_at
FROM users
WHERE user_id = 1;

SELECT *
FROM users
WHERE user_id = 1
  AND email != 'john@mail.com';

-- ============================================================
-- SCENARIO 2: discount_price >= price bug check
-- ============================================================

SELECT product_id, product_name, price, discount_price
FROM products
WHERE discount_price >= price;

-- ============================================================
-- SCENARIO 3: Orphan order_items (no matching order)
-- ============================================================

SELECT oi.*
FROM order_items oi
LEFT JOIN orders o ON oi.order_id = o.order_id
WHERE o.order_id IS NULL;

-- ============================================================
-- SCENARIO 4: Age field boundary review
-- ============================================================

SELECT user_id, name, age,
    CASE
        WHEN age BETWEEN 18 AND 65 THEN 'Should be ACCEPTED'
        ELSE 'Should be REJECTED'
    END AS expected_validation_result
FROM users
WHERE user_id IN (2,3,4,5);

-- ============================================================
-- SCENARIO 5: Money transfer / rollback
-- ============================================================

START TRANSACTION;

    UPDATE accounts
    SET balance = balance - 100.00
    WHERE account_id = 'A';

    INSERT INTO transactions (reference_id, from_account, to_account, amount, status)
    VALUES ('TXN12345', 'A', 'B', 100.00, 'PENDING');

    -- Step 2 (credit B) never runs -- simulating a failure

    ROLLBACK;

SELECT account_id, balance FROM accounts WHERE account_id IN ('A','B');

SELECT * FROM transactions WHERE reference_id = 'TXN12345';

-- ============================================================
-- BONUS: General-purpose validation queries
-- ============================================================

SELECT email, COUNT(*) AS cnt
FROM users
GROUP BY email
HAVING cnt > 1;

SELECT * FROM orders WHERE customer_id IS NULL OR total_amount IS NULL;

SELECT order_item_id, order_id, quantity, unit_price,
       (quantity * unit_price) AS calculated_total
FROM order_items;

SELECT COUNT(*) AS user_count FROM users;
SELECT COUNT(*) AS product_count FROM products;
